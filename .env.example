# 改成 Synology 的固定區網 IP（手機 VPN 必須能連到此 IP）
NAS_BIND_IP=192.168.1.20
PUBLIC_ORIGINS=http://192.168.1.20:5173
# Tailscale Serve 從 NAS 本機的 5174 轉至容器 5173；不會將 5174 公開至區網
TAILSCALE_BACKEND_PORT=5174
# 啟用 Serve 後把實際 ts.net 網址加上；不能帶結尾斜線
# PUBLIC_ORIGINS=http://192.168.1.20:5173,https://nas.your-tailnet.ts.net
# 選用：填入 Anthropic API key 後，搜尋頁會出現「拍照辨識」按鈕（按次計費）。留空則不顯示
ANTHROPIC_API_KEY=
